# Copy to .env and adjust for your environment.
# Consumed in src/api/client.ts and the Vite dev proxy in vite.config.ts.
#
# Base URL for the KYC API. Include the route prefix if the backend mounts its
# routes under one (e.g. `http://localhost:5000/api` or `https://api.example.com/api`);
# request paths in src/api/kyc.ts are then `/kyc/submit` — matching the Postman
# collection where `{{baseUrl}}` is this value.
#
# NOTE: when deploying, also update `connect-src` in public/_headers so the
# Content-Security-Policy allows this origin.
VITE_API_URL=http://localhost:5000/api
